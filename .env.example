# Cekael AI — opsional.
# Tanpa key, Mini AI otomatis memakai local rule-based engine.
# Isi salah satu (Gemini diprioritaskan kalau dua-duanya ada).

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Web3Forms — isi access key kamu dari https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY
